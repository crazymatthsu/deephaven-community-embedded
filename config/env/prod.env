# Environment prod: key-protected, each application on a machine of its own, listening on the
# network. The host name below is an example; put the real one here.
#
# The keys themselves are not here. They come from the environment:
#   DHC_DHC_A_AUTH_PSK         the key instance A asks for
#   DHC_DHC_B_AUTH_PSK         the key instance B asks for
#   DHC_UPSTREAM_DHC_A_PSK     A's key again, for B to present when it subscribes

DHC_AUTH_MODE=psk
DHC_HTTP_HOST=0.0.0.0
DHC_JVM_HEAP=4g

DHC_DHC_A_HTTP_PORT=10000
DHC_DHC_A_WEB_PORT=8080

DHC_DHC_B_HTTP_PORT=10001
DHC_DHC_B_WEB_PORT=8081
DHC_DHC_B_UPSTREAM_DHC_A_URL=dh+plain://dhc-a.example.internal:10000
