# Environment uat: key-protected, on ports of its own, so that it can run beside dev on one
# machine. The same build and the same image as dev; only this file differs.
#
# The keys themselves are not here. They come from the environment:
#   DHC_DHC_A_AUTH_PSK         the key instance A asks for
#   DHC_DHC_B_AUTH_PSK         the key instance B asks for
#   DHC_UPSTREAM_DHC_A_PSK     A's key again, for B to present when it subscribes

DHC_AUTH_MODE=psk
DHC_HTTP_HOST=localhost
DHC_JVM_HEAP=2g

DHC_DHC_A_HTTP_PORT=11000
DHC_DHC_A_WEB_PORT=9080

DHC_DHC_B_HTTP_PORT=11001
DHC_DHC_B_WEB_PORT=9081
DHC_DHC_B_UPSTREAM_DHC_A_URL=dh+plain://localhost:11000
