# Environment dev: both applications on one machine, reachable from that machine only.
#
# One file serves every application, so what differs between them is scoped: DHC_DHC_B_HTTP_PORT
# is DHC_HTTP_PORT for the application dhc-b. Every key here is in uat.env and prod.env too.

# Nobody logs in. Deephaven says so loudly in its log. For development only.
DHC_AUTH_MODE=anonymous
DHC_HTTP_HOST=localhost
DHC_JVM_HEAP=1g

DHC_DHC_A_HTTP_PORT=10000
DHC_DHC_A_WEB_PORT=8080

DHC_DHC_B_HTTP_PORT=10001
DHC_DHC_B_WEB_PORT=8081
DHC_DHC_B_UPSTREAM_DHC_A_URL=dh+plain://localhost:10000
