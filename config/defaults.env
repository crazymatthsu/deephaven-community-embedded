# Every setting of the embedded Deephaven applications, with its default.
#
# Lowest first: this file, apps/<app>.env, env/<environment>.env, the process environment,
# -Ddhc.<name> on the Java command line. DHC_HTTP_PORT and dhc.http.port are the same setting.
# An empty value means "not set here".
#
# Format: KEY=value, one per line. A line starting with '#' is a comment. No quotes, no spaces
# around '=', no variable expansion, so Java, bash and a compose env_file read it the same way.
#
# A key that is not in this file is refused by ./gradlew validateConfig, so a typo in another
# file does not pass for a setting.
#
# Not in any file, on purpose:
#   secrets            the instance's own pre-shared key and an upstream's key are environment
#                      variables only, from each environment's secret store. Their names are in
#                      config/README.md. validateConfig refuses a key that looks like one.
#   DHC_CONFIG_DIR     where this directory is
#   DHC_ENV            which env/<environment>.env applies
#   DHC_WORK_DIR       the instance's own directory; a path on the machine it runs on
#   DHC_APP_DIR        a directory of application-mode modules to run instead of the built-in ones

# ---- Deephaven's own server: web IDE and API -------------------------------------------------

# Interface it listens on. localhost keeps it off the network; 0.0.0.0 inside a container.
DHC_HTTP_HOST=localhost

# Port of the web IDE and the API. 0 picks a free one.
DHC_HTTP_PORT=10000

# How clients log in: psk (a pre-shared key) or anonymous (nobody logs in; development only).
DHC_AUTH_MODE=psk

# Ids of the application-mode modules the instance runs, comma-separated. Set per application.
DHC_APP_MODULES=

# ---- Spring Boot hosts only ------------------------------------------------------------------

# Port of the application's own HTTP side: REST, health, its page. A plain Java host has none.
DHC_WEB_PORT=8080

# true publishes GET /dhc/tables, a list of the instance's tables.
DHC_TABLES_ENDPOINT=false

# ---- The JVM, read by scripts/run.sh and the container entry point ---------------------------

# Maximum heap, as java -Xmx takes it: 1g, 512m.
DHC_JVM_HEAP=1g

# More options for the java command, space-separated. The three mandatory flags are always there.
DHC_JVM_OPTS=

# ---- An instance that subscribes to another (role B) -----------------------------------------

# Where instance A is: dh+plain://host:port, or dh://host:port for TLS.
DHC_UPSTREAM_DHC_A_URL=

# How long to keep trying when an upstream does not answer at start.
DHC_UPSTREAM_CONNECT_TIMEOUT_SECONDS=60

# ---- The mock order feed (role A) ------------------------------------------------------------

# Seed of the feed: the same seed gives the same executions.
DHC_GEN_SEED=42

# Executions a second.
DHC_GEN_RATE=5

# How many orders are being filled at any moment.
DHC_GEN_ORDERS=20

# The feed stops after this many executions. 0 means it never stops.
DHC_GEN_EVENT_LIMIT=0

# How many executions the execs table keeps.
DHC_RING_CAPACITY=10000

# TransactTime of the first execution, like 2026-01-05T14:30:00Z. Empty means now.
DHC_GEN_START_TIME=
