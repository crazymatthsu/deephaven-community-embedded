# Local override of repos.env. Copy to repos.local.env (git-ignored) and uncomment what you need.
# Keys you leave out keep the public defaults from repos.env.
#
# The examples are for a JFrog Artifactory at artifactory.example.com with the usual virtual
# repositories. Use your own host and repository names.

# A virtual repository that proxies Maven Central.
#DHE_MAVEN_REPO_URL=https://artifactory.example.com/artifactory/maven-central/

# A remote repository that proxies https://plugins.gradle.org/m2/.
#DHE_GRADLE_PLUGIN_REPO_URL=https://artifactory.example.com/artifactory/gradle-plugins/

# A remote repository that proxies https://services.gradle.org/distributions.
# Run ./gradlew wrapper after changing it.
#DHE_GRADLE_DISTRIBUTIONS_URL=https://artifactory.example.com/artifactory/gradle-distributions

# If the Artifactory needs a login. The user name and token do NOT go in this file. Put them in
# ~/.gradle/gradle.properties (dheMavenUsername, dheMavenPassword, dhePluginsUsername,
# dhePluginsPassword) or pass them as ORG_GRADLE_PROJECT_* environment variables.
#DHE_REPO_CREDENTIALS=gradle-properties

# A Docker remote repository that proxies Docker Hub.
#DHE_CONTAINER_REGISTRY=artifactory.example.com/docker-remote
