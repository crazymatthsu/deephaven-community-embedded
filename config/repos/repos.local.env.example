# Local override of repos.env. Copy to repos.local.env (git-ignored) and uncomment what you need.
# Keys you leave out keep the values from repos.env.
#
# The examples are for a JFrog Artifactory at artifactory.example.com. Use your own host and
# repository names. To move the whole team instead of one machine, put the same values in
# repos.env and commit them.
#
# After changing DHC_GRADLE_DISTRIBUTIONS_URL, run scripts/sync-gradle-wrapper.sh.

# A remote or virtual repository that proxies Maven Central.
#DHC_MAVEN_REPO_URL=https://artifactory.example.com/artifactory/maven-remote/

# A remote repository that proxies https://plugins.gradle.org/m2/. If one virtual repository
# serves both, use the address above here as well.
#DHC_GRADLE_PLUGIN_REPO_URL=https://artifactory.example.com/artifactory/gradle-plugins-remote/

# A generic remote repository that proxies https://services.gradle.org/distributions.
#DHC_GRADLE_DISTRIBUTIONS_URL=https://artifactory.example.com/artifactory/gradle-distributions-remote

# If the Artifactory needs a login. The user name and token do NOT go in this file; see
# config/README.md for the lines that go in ~/.gradle/gradle.properties.
#DHC_REPO_CREDENTIALS=gradle-properties

# A Docker remote repository that proxies Docker Hub, and the JDK 21 image to build on. Through a
# proxy of Docker Hub the image keeps its name; a company's own hardened JDK image goes here too.
#DHC_CONTAINER_REGISTRY=artifactory.example.com/docker-remote
#DHC_CONTAINER_BASE_IMAGE=library/eclipse-temurin:21-jdk
