# Artifact sources: the one file that says where this project downloads things from.
#
# Read by the dhc.repositories settings plugin (build-logic/repositories-plugin), which is the
# only place the build declares repositories. From P6 the scripts and container builds read the
# same file. Nothing else in the repository names a download address, with one exception: the
# Gradle wrapper keeps a copy (see DHC_GRADLE_DISTRIBUTIONS_URL below).
#
# To move to a company mirror such as JFrog Artifactory:
#   for everyone   edit the four addresses below and commit;
#   for yourself   copy repos.local.env.example to repos.local.env (git-ignored) and override
#                  the keys you need there.
# Either way, run scripts/sync-gradle-wrapper.sh afterwards. config/README.md has the steps.
#
# Format: KEY=value, one per line. A line starting with '#' is a comment. No quotes, no spaces
# around '=', no variable expansion, so Gradle, bash and compose env_file read it the same way.
#
# No user name, password or token belongs here or in repos.local.env. See DHC_REPO_CREDENTIALS.

# Maven repository for every library. The Kafka extension is excluded (F2), so Maven Central is
# enough.
DHC_MAVEN_REPO_URL=https://repo.maven.apache.org/maven2/

# Gradle plugin repository (the kotlin-dsl plugin used by build-logic lives only here). A mirror
# that serves plugins and libraries from one virtual repository can use the same address twice.
DHC_GRADLE_PLUGIN_REPO_URL=https://plugins.gradle.org/m2/

# Where the Gradle wrapper downloads Gradle from. The file name gradle-<version>-bin.zip is
# appended; the version comes from gradle/libs.versions.toml. The wrapper cannot read this file,
# so after changing this run scripts/sync-gradle-wrapper.sh, which copies the address into
# gradle/wrapper/gradle-wrapper.properties. ./gradlew check fails while the two differ.
DHC_GRADLE_DISTRIBUTIONS_URL=https://services.gradle.org/distributions

# none: the repositories above are read anonymously.
# gradle-properties: Gradle logs in to both repositories with one user name and password, which
#   it reads from the Gradle properties dhcRepoUsername and dhcRepoPassword. They live outside
#   the repository: in ~/.gradle/gradle.properties, or in CI as the environment variables
#   ORG_GRADLE_PROJECT_dhcRepoUsername and ORG_GRADLE_PROJECT_dhcRepoPassword.
DHC_REPO_CREDENTIALS=none

# Registry that container base images are pulled from. Used from P6.
DHC_CONTAINER_REGISTRY=docker.io
