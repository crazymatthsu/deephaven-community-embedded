# Artifact sources for the whole build.
#
# Read by the dhc.repositories settings plugin (build-logic/repositories-plugin), which is the
# only place the build declares repositories. From P6 the scripts and container builds read the
# same file.
#
# Format: KEY=value, one per line. A line starting with '#' is a comment. No quotes, no spaces
# around '=', no variable expansion, so Gradle, bash and compose env_file read it the same way.
#
# To build behind a company mirror, copy repos.local.env.example to repos.local.env (git-ignored)
# and override the keys you need. Do not edit this file for that.
#
# No credentials belong here or in repos.local.env. See DHC_REPO_CREDENTIALS.

# Maven repository for every library. The Kafka extension is excluded (F2), so Maven Central is
# enough.
DHC_MAVEN_REPO_URL=https://repo.maven.apache.org/maven2/

# Gradle plugin repository (the kotlin-dsl plugin used by build-logic lives only here).
DHC_GRADLE_PLUGIN_REPO_URL=https://plugins.gradle.org/m2/

# Where the Gradle wrapper downloads Gradle from. The file name gradle-<version>-bin.zip is
# appended; the version comes from gradle/libs.versions.toml. After changing this, run
# ./gradlew wrapper to rewrite gradle/wrapper/gradle-wrapper.properties.
DHC_GRADLE_DISTRIBUTIONS_URL=https://services.gradle.org/distributions

# none: the repositories above are read anonymously.
# gradle-properties: Gradle sends a user name and password that it reads from the Gradle
#   properties dhcMavenUsername / dhcMavenPassword and dhcPluginsUsername / dhcPluginsPassword,
#   for example in ~/.gradle/gradle.properties or as ORG_GRADLE_PROJECT_dhcMavenUsername in CI.
DHC_REPO_CREDENTIALS=none

# Registry that container base images are pulled from. Used from P6.
DHC_CONTAINER_REGISTRY=docker.io
