# Gradle. "build/" matches a directory of that name at any depth, source packages included,
# which is why the build-logic package is called "buildlogic".
.gradle/
build/
.kotlin/

# The local override of config/repos/repos.env (company mirror). Never committed.
config/repos/repos.local.env

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/

# OS
.DS_Store
Thumbs.db

# Java
*.class
*.log
hs_err_pid*
replay_pid*

# Archives are build outputs, with one exception: the Gradle wrapper.
*.jar
*.war
*.zip
*.tar.gz
!gradle/wrapper/gradle-wrapper.jar
