# LF everywhere, so shell scripts and the Gradle wrapper run on Linux, macOS and Git Bash
# whatever core.autocrlf says. Windows batch files are the one exception.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binaries.
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
